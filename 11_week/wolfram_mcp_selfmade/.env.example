# Wolfram|Alpha MCP — example environment file.
# Copy to `.env` and fill in your own values. NEVER commit the real `.env`.
#   cp .env.example .env

# --- Required: your free Wolfram|Alpha AppID (2,000 non-commercial calls/month) ---
# Get one at https://developer.wolframalpha.com/  (My Apps -> Get an AppID).
WOLFRAM_APP_ID=XXXXXX-XXXXXXXXXX

# --- Optional: per-endpoint AppID overrides ---
# One AppID works for every endpoint; set these only if you generated several keys
# and want separate quotas/tracking. Each falls back to WOLFRAM_APP_ID if unset.
# WOLFRAM_APP_ID_LLM=
# WOLFRAM_APP_ID_SHORT=
# WOLFRAM_APP_ID_SPOKEN=
# WOLFRAM_APP_ID_SIMPLE=
# WOLFRAM_APP_ID_FULL=

# --- Optional: MCP transport / network (defaults are fine for Claude Code stdio) ---
# WOLFRAM_MCP_TRANSPORT=stdio        # stdio | streamable-http | sse
# WOLFRAM_MCP_HOST=127.0.0.1
# WOLFRAM_MCP_PORT=8000

# --- Optional: advisory local quota tracking ---
# WOLFRAM_TRACK_USAGE=1              # set 0 to disable
# WOLFRAM_USAGE_FILE=                # custom path, or "off" to disable
# WOLFRAM_MONTHLY_LIMIT=2000
# WOLFRAM_DAILY_LIMIT=100

# --- Optional: in-process TTL response cache (seconds; 0 = disabled) ---
# Reuses identical idempotent queries to save quota. Keep it short so
# time-sensitive answers (prices, "today") don't go stale.
# WOLFRAM_CACHE_TTL=0
